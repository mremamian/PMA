# Copy this file to `.env` and adjust to match your PostgreSQL instance.

# Either set a single connection string...
# Port 5433 is what docker-compose.yml publishes (5432 is taken on this machine).
DATABASE_URL=postgres://pma:pma_dev_password@localhost:5433/pma

# ...or the discrete parts (DATABASE_URL wins if both are present).
PGHOST=localhost
PGPORT=5433
PGUSER=pma
PGPASSWORD=pma_dev_password
PGDATABASE=pma

# Set to "require" when talking to a managed/cloud PostgreSQL instance.
PGSSLMODE=disable

# HTTP server
PORT=3001
# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:4200
